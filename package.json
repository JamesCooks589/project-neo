{
  "name": "project-neo",
  "version": "0.1.0",
  "private": true,
  "description": "A visual API workflow tester with a shared model for people and AI assistants.",
  "author": "James Cooks",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "clean": "node scripts/clean.cjs",
    "typecheck": "npm run build && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && jest --runInBand",
    "test:ci": "npm run build && node -e \"require('node:fs').mkdirSync('test-results',{recursive:true})\" && jest --ci --runInBand --coverage --json --outputFile=test-results/jest.json",
    "schema:export": "npm run build && node scripts/export-schema.cjs",
    "schema:check": "npm run build && node scripts/export-schema.cjs --check",
    "demo": "npm run build && node tools/runner/dist/src/cli.js",
    "fixture": "npm run build && node tools/fixture-api/dist/src/cli.js",
    "check": "npm run format:check && npm run typecheck && npm run test:ci && npm run schema:check"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
